{
  "expo": {
    "name": "ceretime",
    "slug": "ceretime",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "ceretime",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cl.rmv.ceretime"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "owner": "corvidown-crew",
    "extra": {
      "eas": {
        "projectId": "ff9003db-9d48-429f-9461-ad924f4bd6fc"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CERETI usa el micrófono para reconocer comandos cuando lo solicitas.",
          "speechRecognitionPermission": "CERETI reconoce comandos de voz en el dispositivo cuando lo solicitas.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ]
  }
}
