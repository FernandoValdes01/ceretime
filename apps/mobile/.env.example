# URL pública del deployment de prueba entregado por TI2, sin tokens ni secretos.
# Copia este archivo a .env.local y completa la URL antes de usar los adaptadores reales.
# La demostración local funciona sin esta variable. El ingreso institucional se conecta por separado.
EXPO_PUBLIC_CONVEX_URL=

# Escenario del adaptador ficticio: success | fail-once
EXPO_PUBLIC_STUDENT_REQUEST_DEMO_MODE=success
# Escenario del listado ficticio: success | empty | error
EXPO_PUBLIC_STUDENT_AREA_DEMO_MODE=success
# Retraso opcional en ms para observar el estado loading
EXPO_PUBLIC_STUDENT_AREA_DELAY_MS=0
# Las claves del Practicante conservan «PRACTITIONER» para no romper los .env existentes.
# Escenario del listado ficticio del Practicante: success | empty | error
EXPO_PUBLIC_PRACTITIONER_ACCOMPANIMENT_MODE=success
# Retraso opcional en ms para observar el estado loading del Practicante
EXPO_PUBLIC_PRACTITIONER_ACCOMPANIMENT_DELAY_MS=0
# Escenario del listado ficticio del Profesional: success | empty | error
EXPO_PUBLIC_PROFESSIONAL_ACCOMPANIMENT_MODE=success
# Retraso opcional en ms para observar el estado loading del Profesional
EXPO_PUBLIC_PROFESSIONAL_ACCOMPANIMENT_DELAY_MS=0
