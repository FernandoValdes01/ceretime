# Variables públicas del cliente web (TI2-3). Visibles en el navegador: solo
# localizan servicios, nunca llevan secretos ni credenciales.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Origen local de la SPA en desarrollo (p. ej. http://localhost:5173). Debe
# coincidir con SITE_URL del deployment Convex y con los orígenes
# autorizados en Google Cloud Console.
VITE_SITE_URL=
