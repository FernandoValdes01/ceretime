# Variables públicas del cliente web (TI2-3). Visibles en el navegador: solo
# localizan servicios, nunca llevan secretos ni credenciales.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Origen local de la SPA en desarrollo (p. ej. http://localhost:5173). El
# login vuelve a este origen, así que debe ser SITE_URL o estar en
# BETTER_AUTH_TRUSTED_ORIGINS del deployment Convex, y figurar entre los
# orígenes autorizados en Google Cloud Console. Vacía, el login vuelve a
# SITE_URL.
VITE_SITE_URL=
