{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "ti2": {
      "mode": "primary",
      "description": "Agente TI2: web y backend. Las skills de mobile quedan bloqueadas.",
      "permission": {
        "skill": {
          "building-native-ui": "deny",
          "shadcn": "allow",
          "web-design-guidelines": "allow"
        }
      }
    },
    "ti4": {
      "mode": "primary",
      "description": "Agente TI4: mobile y supervisión de TI2.",
      "permission": {
        "skill": {
          "building-native-ui": "allow",
          "shadcn": "deny",
          "web-design-guidelines": "deny"
        }
      }
    }
  }
}
