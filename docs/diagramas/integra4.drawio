        </mxCell>
        <mxCell id="nota-admin" value="Administrador: cuentas, espacios, configuración, privacidad y reportes agregados. Administrar una cuenta no da acceso libre a acompañamientos ni a notas internas." style="rounded=1;arcSize=8;fillColor=none;strokeColor=light-dark(#8F8F8F,#8F8F8F);strokeWidth=1.2;dashed=1;dashPattern=4 4;whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=middle;spacing=14;fontColor=light-dark(#555555,#C7C7C7);fontFamily=Helvetica;" vertex="1" parent="1">
