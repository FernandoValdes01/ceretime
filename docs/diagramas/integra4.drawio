        </mxCell>
        <mxCell id="t221" value="LEYENDA · El Estudiante reserva una atención individual compatible y el Profesional coordina una multiprofesional. Google Calendar y .ics sólo por acción explícita; acceso a la atención verificado en backend. El Administrador gestiona cuentas y reportes sin acceso irrestricto a acompañamientos." style="rounded=1;arcSize=8;fillColor=none;strokeColor=light-dark(#8F8F8F,#8F8F8F);strokeWidth=1.2;dashed=1;dashPattern=4 4;whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=middle;spacing=14;fontColor=light-dark(#555555,#C7C7C7);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="3790" width="2620" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nota-estados" value="Solicitud: recibida → en revisión → esperando información o aceptación del estudiante → aceptada / derivada / cerrada sin acompañamiento / cancelada. Nunca «rechazada»." style="rounded=1;arcSize=8;fillColor=none;strokeColor=light-dark(#8F8F8F,#8F8F8F);strokeWidth=1.2;dashed=1;dashPattern=4 4;whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=middle;spacing=14;fontColor=light-dark(#555555,#C7C7C7);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="3900" width="1280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nota-practicante" value="RF-39: Profesional habilita cuenta Practicante; concede o revoca por separado el acceso a sus acompañamientos autorizados. Practicante: consulta minimizada, sin notas internas ni escritura." style="rounded=1;arcSize=8;fillColor=none;strokeColor=light-dark(#8F8F8F,#8F8F8F);strokeWidth=1.2;dashed=1;dashPattern=4 4;whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=middle;spacing=14;fontColor=light-dark(#555555,#C7C7C7);fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1380" y="3900" width="1280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nota-cierre" value="Al cerrar un acompañamiento se conserva historial sólo lectura; no se reabre. Una nueva necesidad origina una solicitud y un acompañamiento nuevos." style="rounded=1;arcSize=8;fillColor=none;strokeColor=light-dark(#8F8F8F,#8F8F8F);strokeWidth=1.2;dashed=1;dashPattern=4 4;whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=middle;spacing=14;fontColor=light-dark(#555555,#C7C7C7);fontFamily=Helvetica;" vertex="1" parent="1">
